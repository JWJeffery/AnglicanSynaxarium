---
import Base from '../layouts/Base.astro';
import Stepper from '../components/Stepper.astro';
import MonthSection from '../components/MonthSection.astro';
import PrintSection from '../components/PrintSection.astro';
import KalIndex from '../components/KalIndex.astro';
import Cover from '../components/Cover.astro';
import { dayByKey, entries, rankOf, titleOf, inline, site, hasPodcast } from '../lib/data';
import { episodeByKey, audioUrl, feed } from '../lib/podcast';
import { keyOf, seasonOf, RANK_LABEL } from '../lib/church-year';
import fs from 'node:fs';
import { badgeFor } from '../lib/badges';
const heroArt = !hasPodcast && fs.existsSync('public/cover-800.png');

const now = new Date();
const year = now.getUTCFullYear(), month = now.getUTCMonth() + 1, day = now.getUTCDate();
const key = keyOf(month, day);
const d = dayByKey.get(key)!;
const entry = entries.get(key);
const rank = rankOf(key);
const names: [string, string][] = [['spotify', 'Spotify'], ['apple_podcasts', 'Apple Podcasts'], ['pocket_casts', 'Pocket Casts'], ['youtube', 'YouTube'], ['substack', 'Substack'], ['rss', 'RSS feed']];
const links = names.filter(([k]) => (site.podcast as Record<string, string>)[k]);
const listing = links.map(([k, label]) => ({ label, href: (site.podcast as Record<string, string>)[k], badge: badgeFor(k) }));
// The welcome recording (a file named "Welcome - ...") has no calendar day, so it is played here.
const welcome = episodeByKey.get('welcome');
const welcomeTitle = feed.welcome_title || `Welcome to ${feed.title}`;
const welcomeReleased = !!welcome && new Date(welcome.published).getTime() <= Date.now();
// Before the launch date the home page is a "coming" page instead of today's (not yet written) saint. The same test
// is made again in the visitor's browser (scripts/home.ts), so the page changes over on its own at launch.
const launchKey = String(site.launch).slice(0, 10);
const todayIso = `${year}-${String(month).padStart(2, '0')}-${String(day).padStart(2, '0')}`;
const prelaunch = todayIso < launchKey;
const launchLabel = new Date(`${launchKey}T00:00:00Z`).toLocaleDateString('en-US', { month: 'long', day: 'numeric', timeZone: 'UTC' });
const launchIsAllSaints = launchKey.slice(5) === '11-01';
const trailerMinutes = welcome ? Math.max(1, Math.round(welcome.seconds / 60)) : 0;
const listenPre = `Daily episodes begin ${launchLabel}. Hear the trailer now.`;
const listenLive = 'A saint’s life, read aloud each day.';
---
<Base title="An Anglican Synaxarium" description="One saint for every day of the year, read in the Anglican manner." path="/">
  <main id="top">
    <section id="today" class="today" data-season={seasonOf(year, month, day)} data-hero data-key={key} data-year={year} data-month={month} data-launch={launchKey} data-mode={prelaunch ? 'prelaunch' : 'live'}>
      <div class="season-band"><div class="wrap"><Stepper key={key} year={year} /></div></div>
      <div class="wrap hero-wrap">
        <div class="hero-row">
          <div class="hero-main">
            <div data-prelaunch>
              <span class="rank" data-rank="principal">Begins {launchLabel}</span>
              <h1 class="hero-title">A saint for every day of the year.</h1>
              <p class="hero-lede">An Anglican Synaxarium opens {launchIsAllSaints ? 'on All Saints’ Day' : `on ${launchLabel}`}: the lives of the saints, told in writing and read aloud, one for each day of the church year.</p>
              <p class="hero-first">The trailer is ready to hear now, and the Kalendar is open to browse.</p>
              <div class="hero-actions">
                {welcome && <a class="btn btn-primary" href="#welcome">Hear the trailer</a>}
                <a class="btn" href="#calendar">Browse the Kalendar</a>
              </div>
            </div>
            <span class="rank" data-rank={rank} data-slot="rank">{RANK_LABEL[rank]}</span>
            <h1 class="hero-title" data-slot="title">{titleOf(d)}</h1>
            <p class="hero-period" data-slot="period" hidden={!d.period}>{d.period}</p>
            <p class="hero-lede" data-slot="lede" hidden={!entry} set:html={entry ? inline(entry.body[0]) : ''}></p>
            <p class="hero-first" data-slot="first" hidden={!entry} set:html={entry ? inline(entry.body[1] ?? '') : ''}></p>
            <p class="hero-first" data-slot="prep" hidden={!!entry} style="color:var(--ink-muted)"><span class="lab">Coming soon</span><br />This saint’s entry is still being written.</p>
            <div class="hero-actions" data-slot="actions" hidden={!entry}>
              <a class="btn btn-primary" data-slot="read" href={`/saint/${key}/`}>Read the full entry</a>
              <a class="btn" data-slot="listen" href="/#today" hidden>Listen</a>
              <a class="btn" href="#print">Print this saint</a>
              <a class="btn" data-slot="uo" href={`https://theuniversaloffice.com/?entry=anglican&date=${year}-${key}&utm_source=anglicansynaxarium`} rel="noopener">Pray today’s Office</a>
            </div>
          </div>
          <div class="hero-side">
            {heroArt && <img class="hero-art" src="/cover-800.png" width="800" height="800" alt="An Anglican Synaxarium" />}
            {hasPodcast && (
              <section id="listen" class="card">
                <div class="listen-head">
                  <Cover />
                  <div class="listen-copy">
                    <h2>Listen to the podcast</h2>
                    <p data-slot="listen-sub" data-pre={listenPre} data-live={listenLive}>{prelaunch ? listenPre : listenLive}</p>
                  </div>
                </div>
                {welcome && (
                  <div class="hear" id="welcome" data-hear data-published={welcome.published} hidden={!welcomeReleased}>
                    <p class="lab">The trailer · {trailerMinutes} min</p>
                    <audio controls preload="none" aria-label={`The trailer for ${feed.title}`} src={audioUrl(welcome)}>Your browser cannot play audio here. <a href={audioUrl(welcome)}>Download the recording.</a></audio>
                    <a class="hear-dl" href={audioUrl(welcome)} download>Download the recording (MP3)</a>
                  </div>
                )}
                <div class="platforms">
                  {listing.map((p) => p.badge.light
                    ? <a class={p.badge.dark ? 'platform badge has-dark' : 'platform badge'} href={p.href} rel="noopener" aria-label={`Listen on ${p.label}`}>
                        <img class="for-light" src={p.badge.light} alt={`Listen on ${p.label}`} height="40" />
                        {p.badge.dark && <img class="for-dark" src={p.badge.dark} alt="" height="40" />}
                      </a>
                    : <a class="platform text" href={p.href} rel="noopener">{p.label}</a>)}
                </div>
              </section>
            )}
            <section class="card others" data-slot="others" hidden={d.alternates.length === 0}>
              <h2>Other Saints Commemorated Today</h2>
              <ul data-slot="others-list">
                {d.alternates.map((a) => <li>{a.name}{(a.designation || a.period) && <> <span class="alt-sub">{[a.designation, a.period].filter(Boolean).join(', ')}</span></>}</li>)}
              </ul>
            </section>
          </div>
        </div>
      </div>
    </section>

    <section id="calendar" class="kal-section">
      <div class="wrap">
        <MonthSection year={year} month={month} todayKey={key} selectedKey={key} />
      </div>
    </section>

    <PrintSection key={key} />
  </main>
  <KalIndex />
  <script>
    import { initHome } from '../scripts/home';
    initHome();
  </script>
</Base>
