---
import '../styles/site.css';
import { site, hasPodcast } from '../lib/data';
interface Props { title: string; description: string; path: string; }
const { title, description, path } = Astro.props;
const url = new URL(path, site.site).toString();
const og = new URL('/og.png', site.site).toString();
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={url} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={site.name} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={url} />
  <meta property="og:image" content={og} />
  <meta name="twitter:card" content="summary" />
  <meta name="color-scheme" content="light" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preload" href="/fonts/fraunces-latin-opsz-normal.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/newsreader-latin-opsz-normal.woff2" as="font" type="font/woff2" crossorigin />
</head>
<body>
  <div class="page">
    <header class="site-header">
      <div class="wrap">
        <a class="wordmark" href="/" aria-label="An Anglican Synaxarium, home">
          <span class="wordmark-top">An Anglican</span>
          <span class="wordmark-main">Synaxarium</span>
        </a>
        <nav class="nav" aria-label="Main">
          <a href="/#today">Saint of the Day</a>
          <a href="/kalendar/">Kalendar</a>
          <a href="/print/">Print</a>
          {hasPodcast && <a href="/#listen">Listen</a>}
        </nav>
      </div>
    </header>
    <slot />
    <footer class="site-footer">
      <div class="wrap">
        <p class="name">An Anglican Synaxarium</p>
        <nav aria-label="Footer">
          {hasPodcast && <a href="/#listen">Podcast</a>}
          <a href="/print/">Print</a>
          <a href="/kalendar/">Kalendar</a>
        </nav>
      </div>
    </footer>
  </div>
</body>
</html>
