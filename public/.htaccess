# anglicansynaxarium.com: feed address, feed source protection, audio type.
AddType audio/mpeg .mp3

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^feed\.xml$ feed.php [L]
</IfModule>

# The full feed (with unreleased episodes) is read by feed.php only.
<Files "feed-source.xml">
<IfModule mod_authz_core.c>
Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
Order allow,deny
Deny from all
</IfModule>
</Files>

# The service worker and manifest must be re-checked every visit, or app updates would not arrive.
<IfModule mod_headers.c>
<FilesMatch "^(sw\.js|manifest\.webmanifest)$">
Header set Cache-Control "no-cache"
</FilesMatch>
</IfModule>
AddType application/manifest+json .webmanifest

# Send text files compressed; the offline copy downloads about four times faster.
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/manifest+json
</IfModule>
