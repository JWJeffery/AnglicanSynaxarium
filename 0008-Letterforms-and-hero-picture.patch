diff --git a/src/pages/index.astro b/src/pages/index.astro
index 65580f0..1968110 100644
--- a/src/pages/index.astro
+++ b/src/pages/index.astro
@@ -7,6 +7,8 @@ import KalIndex from '../components/KalIndex.astro';
 import Cover from '../components/Cover.astro';
 import { dayByKey, entries, rankOf, titleOf, inline, site, hasPodcast } from '../lib/data';
 import { keyOf, seasonOf, RANK_LABEL } from '../lib/church-year';
+import fs from 'node:fs';
+const heroArt = !hasPodcast && fs.existsSync('public/cover-800.png');
 
 const now = new Date();
 const year = now.getUTCFullYear(), month = now.getUTCMonth() + 1, day = now.getUTCDate();
@@ -36,6 +38,7 @@ const links = names.filter(([k]) => (site.podcast as Record<string, string>)[k])
             </div>
           </div>
           <div class="hero-side">
+            {heroArt && <img class="hero-art" src="/cover-800.png" width="800" height="800" alt="An Anglican Synaxarium" />}
             {hasPodcast && (
               <section id="listen" class="card">
                 <div class="listen-head">
diff --git a/src/styles/site.css b/src/styles/site.css
index 8e36a57..c8f8b50 100644
--- a/src/styles/site.css
+++ b/src/styles/site.css
@@ -73,6 +73,8 @@ a { color: inherit; }
 .hero-first { font-size: 19px; line-height: 30px; max-width: 34rem; text-wrap: pretty; }
 .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; padding-top: 6px; }
 .hero-side { flex: 1 1 380px; min-width: 0; display: flex; flex-direction: column; gap: 16px; }
+.hero-art { display: block; width: min(100%, 360px); height: auto; border-radius: 4px; box-shadow: var(--shadow-leaf); }
+@media (max-width: 700px) { .hero-art { width: min(100%, 280px); } }
 .card { background: var(--surface-raised); border: 1px solid var(--hairline); border-radius: 8px; padding: 24px; display: flex; flex-direction: column; gap: 14px; }
 .card h2 { font-family: var(--font-display); font-weight: 600; font-size: 24px; line-height: 28px; }
 .card p { font-size: 17px; line-height: 24px; }
diff --git a/src/styles/tokens.css b/src/styles/tokens.css
index 868d264..09dd638 100644
--- a/src/styles/tokens.css
+++ b/src/styles/tokens.css
@@ -3,8 +3,8 @@
 @font-face { font-family: "Fraunces"; src: url("/fonts/fraunces-latin-opsz-italic.woff2") format("woff2"); font-weight: 100 900; font-style: italic; font-display: swap; }
 @font-face { font-family: "Newsreader"; src: url("/fonts/newsreader-latin-opsz-normal.woff2") format("woff2"); font-weight: 200 800; font-style: normal; font-display: swap; }
 @font-face { font-family: "Newsreader"; src: url("/fonts/newsreader-latin-opsz-italic.woff2") format("woff2"); font-weight: 200 800; font-style: italic; font-display: swap; }
-/* Fraunces draws a capital J that hangs below the line. Only the letter J comes from Literata, which sits on the baseline. */
-@font-face { font-family: "Fraunces J"; src: url("/fonts/literata-j.woff2") format("woff2"); font-weight: 200 900; font-style: normal; font-display: swap; unicode-range: U+004A; }
+/* Fraunces draws a J that hangs below the line and an F and f with odd flagged shapes. Only those three letters come from Literata. */
+@font-face { font-family: "Fraunces J"; src: url("/fonts/literata-jf.woff2") format("woff2"); font-weight: 200 900; font-style: normal; font-display: swap; unicode-range: U+004A, U+0046, U+0066; }
 @font-face { font-family: "Instrument Sans"; src: url("/fonts/instrument-sans-latin-wght-normal.woff2") format("woff2"); font-weight: 400 700; font-style: normal; font-display: swap; }
 
 :root {
diff --git a/tools/make-cover-images.mjs b/tools/make-cover-images.mjs
index 01ee8a7..c290287 100644
--- a/tools/make-cover-images.mjs
+++ b/tools/make-cover-images.mjs
@@ -1,6 +1,7 @@
 // Makes the two images the site needs from the full-size green cover.
 // Put synaxarium-cover-green-3000.png in public/assets/, then run:  npm run cover
 //   public/cover-400.png  the Listen card (shown at 96 px, sharp on phones)
+//   public/cover-800.png  the large picture beside the saint on the home page (until podcast links exist)
 //   public/og.png         the sharing image, 1200 x 1200
 import fs from 'node:fs';
 import sharp from 'sharp';
@@ -11,5 +12,6 @@ if (!fs.existsSync(src)) {
   process.exit(1);
 }
 await sharp(src).resize(400, 400).png({ compressionLevel: 9 }).toFile('public/cover-400.png');
+await sharp(src).resize(800, 800).png({ compressionLevel: 9 }).toFile('public/cover-800.png');
 await sharp(src).resize(1200, 1200).png({ compressionLevel: 9 }).toFile('public/og.png');
-console.log('wrote public/cover-400.png and public/og.png');
+console.log('wrote public/cover-400.png, public/cover-800.png and public/og.png');
